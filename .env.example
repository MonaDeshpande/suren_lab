# =============================================================================
# SLS Lab — environment variables (copy this file to .env and edit values)
# =============================================================================

# PostgreSQL connection (Docker maps host 5433 → container 5432)
# Use 127.0.0.1 to avoid Windows localhost resolving to ::1 (local PG conflict)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=sls_lab
POSTGRES_USER=sls_user
POSTGRES_PASSWORD=sls_secure_password

# Streamlit / app
APP_TITLE=S Testing Laboratory
